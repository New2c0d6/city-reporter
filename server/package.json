{
  "name": "city-reporter-server",
  "version": "0.1.0",
  "type": "module",
  "description": "City Reporter MVP backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--loader ts-node/esm' node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "NODE_OPTIONS='--loader ts-node/esm' node src/db/migrate.ts",
    "db:test": "NODE_OPTIONS='--loader ts-node/esm' node src/db/test.ts",
    "db:validate": "NODE_OPTIONS='--loader ts-node/esm' node src/db/validate-schema.ts",
    "lint": "echo 'Linting via TypeScript strict mode'",
    "lint:fix": "echo 'Linting via TypeScript strict mode'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.3",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
